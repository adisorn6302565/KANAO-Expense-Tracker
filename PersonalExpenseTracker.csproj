<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Version>1.1.1</Version>
    <AssemblyName>KANAO-ExpenseTracker</AssemblyName>
    <Product>KANAO Expense Tracker</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <!-- WPF's temporary markup project passes every roslynX.Y copy of the MVVM generator,
       producing duplicate members (CS0102). Keep one copy that works on any .NET 8 SDK. -->
  <!-- The WPF temp project can load the MVVM generator from several roslyn* folders at once (CS0102).
       Only when that happens, keep the newest folder this compiler supports. -->
  <Target Name="DedupeMvvmGenerators" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_MvvmGen Include="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.Identity)').ToLowerInvariant().Contains('communitytoolkit.mvvm'))" />
      <_MvvmDir Include="@(_MvvmGen->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <PropertyGroup>
      <_RoslynVer>$(CompilerApiVersion.Replace('roslyn', ''))</_RoslynVer>
      <_RoslynVer Condition="'$(_RoslynVer)' == ''">4.0</_RoslynVer>
      <_MvvmKeep>roslyn4.0</_MvvmKeep>
      <_MvvmKeep Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_RoslynVer)', '4.3'))">roslyn4.3</_MvvmKeep>
      <_MvvmKeep Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_RoslynVer)', '4.12'))">roslyn4.12</_MvvmKeep>
    </PropertyGroup>
    <ItemGroup Condition="@(_MvvmDir->Count()) &gt; 1">
      <Analyzer Remove="@(_MvvmGen)" Condition="!$([System.String]::Copy('%(Identity)').Contains('\$(_MvvmKeep)'))" />
    </ItemGroup>
  </Target>

</Project>
